# Forma Server Intelligence Platform - Backend Configuration
# Cognifyz Level 4: Expert - Task 8: Advanced Server-Side Functionality

# Server Network Configuration
PORT=5002
NODE_ENV=development
CLIENT_URL=http://localhost:5175

# Redis Configuration (BullMQ Queues and Server-Side Caching)
# Standard local Redis port is 6379.
# If Redis is unavailable, the application gracefully operates in documented Development Fallback mode
# with transparent reporting on the dashboard and diagnostic endpoints.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
# Optional full Redis URI (overrides individual REDIS_* fields if provided):
# REDIS_URL=redis://127.0.0.1:6379

# MongoDB Configuration (Mongoose persistence for job execution logs and telemetry)
# If MongoDB is unavailable, the application operates in documented in-memory document store mode.
MONGODB_URI=mongodb://127.0.0.1:27017/forma_task8

# Cache Configuration
CACHE_DEFAULT_TTL_SECONDS=60
CACHE_NAMESPACE=forma:v1

# Queue Configuration
QUEUE_CONCURRENCY=3
QUEUE_MAX_STALLED_COUNT=2

