<!-- ========== CONTACT PAGE ========== -->
<section class="contact-section section py-5 bg-light">
  <div class="container">
    <div class="row justify-content-center mb-5 animate-fade-in-up">
      <div class="col-lg-8 text-center">
        <h1 class="section-title fw-bold mb-3">Contact Us</h1>
        <p class="section-subtitle text-muted">
          Have questions about Forma? We'd love to hear from you.
        </p>
      </div>
    </div>

    <div class="row g-5">
      <div class="col-lg-6 animate-fade-in-up animate-delay-100">
        <div class="card border-0 shadow-sm forma-card h-100">
          <div class="card-body p-5">
            <h5 class="fw-bold mb-4">Get in Touch</h5>
            <p class="text-muted mb-4">
              Whether you have questions about the platform, need support with
              student registration, or want to learn more about Forma, our team
              is here to help.
            </p>
            <div class="contact-info mb-4">
              <div class="d-flex mb-3">
                <div class="contact-icon me-3">&#9993;</div>
                <div>
                  <h6 class="fw-bold mb-1">Email</h6>
                  <p class="text-muted mb-0 small">support@forma.university</p>
                </div>
              </div>
              <div class="d-flex mb-3">
                <div class="contact-icon me-3">&#128222;</div>
                <div>
                  <h6 class="fw-bold mb-1">Location</h6>
                  <p class="text-muted mb-0 small">Cognifyz IT Solutions Campus</p>
                </div>
              </div>
              <div class="d-flex">
                <div class="contact-icon me-3">&#128222;</div>
                <div>
                  <h6 class="fw-bold mb-1">Hours</h6>
                  <p class="text-muted mb-0 small">Mon – Fri, 9:00 AM – 6:00 PM</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-6 animate-fade-in-up animate-delay-200">
        <div class="card border-0 shadow-lg forma-card h-100">
          <div class="card-body p-5">
            <h5 class="fw-bold mb-4">Send a Message</h5>
            <form action="#" method="POST" class="contact-form" novalidate>
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label fw-semibold">Name <span class="required">*</span></label>
                  <input type="text" class="form-control forma-input" placeholder="Your full name" required>
                  <div class="invalid-feedback">Please enter your name.</div>
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-semibold">Email <span class="required">*</span></label>
                  <input type="email" class="form-control forma-input" placeholder="you@example.com" required>
                  <div class="invalid-feedback">Please enter a valid email address.</div>
                </div>
                <div class="col-12">
                  <label class="form-label fw-semibold">Subject <span class="required">*</span></label>
                  <input type="text" class="form-control forma-input" placeholder="What is this regarding?" required>
                  <div class="invalid-feedback">Please enter a subject.</div>
                </div>
                <div class="col-12">
                  <label class="form-label fw-semibold">Message <span class="required">*</span></label>
                  <textarea class="form-control forma-input" rows="5" placeholder="How can we help you?" required></textarea>
                  <div class="invalid-feedback">Please enter your message.</div>
                </div>
                <div class="col-12 d-grid">
                  <button type="submit" class="btn btn-primary px-5 py-3 shadow-sm">Send Message</button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>