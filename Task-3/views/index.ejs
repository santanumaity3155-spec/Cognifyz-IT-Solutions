<!-- ========== REGISTRATION SECTION ========== -->
<section id="registration" class="registration-section section py-5 bg-white">
  <div class="container">
    <div class="row justify-content-center mb-5">
      <div class="col-lg-8 text-center">
        <h2 class="section-title fw-bold mb-3 animate-fade-in-up">Student Registration</h2>
        <p class="section-subtitle text-muted animate-fade-in-up animate-delay-100">
          Create an academic profile in under a minute. All fields are required.
        </p>
      </div>
    </div>

    <% if (errors && errors.length > 0) { %>
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="alert alert-danger animate-shake" role="alert">
            <h6 class="alert-heading fw-bold">Please fix the following errors:</h6>
            <ul class="mb-0">
              <% errors.forEach(function (err) { %>
                <li><a href="#field-<%= err.field %>" class="text-danger"><%= err.message %></a></li>
              <% }); %>
            </ul>
          </div>
        </div>
      </div>
    <% } %>
    <% if (errors && errors.length > 0) { %>
      <script id="server-errors" type="application/json"><%- JSON.stringify(errors) %></script>
    <% } %>

    <div class="row justify-content-center">
      <div class="col-lg-8">
        <form action="/register" method="POST" class="registration-form card p-4 p-md-5 rounded-4 shadow-sm forma-card" id="registrationForm" novalidate>
          <div class="form-grid row g-4">

            <div class="col-md-6">
              <div class="form-group" id="field-fullName">
                <label for="fullName" class="form-label fw-semibold">Full Name <span class="required">*</span></label>
                <input type="text" id="fullName" name="fullName" maxlength="100"
                  class="form-control forma-input"
                  value="<%= (formData && formData.fullName) ? formData.fullName : '' %>"
                  placeholder="e.g. Alex Rivera" autocomplete="name">
                <span class="form-text field-hint">Full legal name as it appears on academic records.</span>
                <div class="invalid-feedback" id="error-fullName"></div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="form-group" id="field-email">
                <label for="email" class="form-label fw-semibold">Email Address <span class="required">*</span></label>
                <input type="email" id="email" name="email" maxlength="255"
                  class="form-control forma-input"
                  value="<%= (formData && formData.email) ? formData.email : '' %>"
                  placeholder="alex.rivera@university.edu" autocomplete="email">
                <span class="form-text field-hint">We use this for account-related communications.</span>
                <div class="invalid-feedback" id="error-email"></div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="form-group" id="field-phone">
                <label for="phone" class="form-label fw-semibold">Phone Number <span class="required">*</span></label>
                <input type="tel" id="phone" name="phone" maxlength="20"
                  class="form-control forma-input"
                  value="<%= (formData && formData.phone) ? formData.phone : '' %>"
                  placeholder="+1 (555) 000-0000" autocomplete="tel">
                <span class="form-text field-hint">7–20 digits, optional leading +.</span>
                <div class="invalid-feedback" id="error-phone"></div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="form-group" id="field-studentId">
                <label for="studentId" class="form-label fw-semibold">Student ID <span class="required">*</span></label>
                <input type="text" id="studentId" name="studentId" maxlength="20"
                  class="form-control forma-input"
                  value="<%= (formData && formData.studentId) ? formData.studentId : '' %>"
                  placeholder="e.g. STU-2024-001" autocomplete="off">
                <span class="form-text field-hint">Alphanumeric plus hyphens, 3–20 characters.</span>
                <div class="invalid-feedback" id="error-studentId"></div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="form-group" id="field-course">
                <label for="course" class="form-label fw-semibold">Course of Study <span class="required">*</span></label>
                <select id="course" name="course" class="form-select forma-select">
                  <option value="">Select a course</option>
                  <% courses.forEach(function (c) { %>
                    <option value="<%= c %>" <%= (formData && formData.course == c) ? 'selected' : '' %>><%= c %></option>
                  <% }); %>
                </select>
                <span class="form-text field-hint">Choose your primary academic program.</span>
                <div class="invalid-feedback" id="error-course"></div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="form-group" id="field-gender">
                <label class="form-label fw-semibold">Gender <span class="required">*</span></label>
                <div class="row g-2">
                  <% genders.forEach(function (g) { %>
                    <div class="col-6">
                      <label class="radio-label d-block p-3 border rounded-3 forma-radio <%= (formData && formData.gender == g) ? 'border-primary bg-primary bg-opacity-10' : 'border-secondary' %>">
                        <input type="radio" name="gender" value="<%= g %>"
                          <%= (formData && formData.gender == g) ? 'checked' : '' %>>
                        <span class="radio-text d-block"><%= g %></span>
                      </label>
                    </div>
                  <% }); %>
                </div>
                <div class="invalid-feedback" id="error-gender"></div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="form-group" id="field-dateOfBirth">
                <label for="dateOfBirth" class="form-label fw-semibold">Date of Birth <span class="required">*</span></label>
                <input type="date" id="dateOfBirth" name="dateOfBirth"
                  class="form-control forma-input"
                  value="<%= (formData && formData.dateOfBirth) ? formData.dateOfBirth : '' %>">
                <span class="form-text field-hint">You must be at least 10 years old.</span>
                <div class="invalid-feedback" id="error-dateOfBirth"></div>
              </div>
            </div>

            <div class="col-12">
              <div class="form-group" id="field-address">
                <label for="address" class="form-label fw-semibold">Address <span class="required">*</span></label>
                <textarea id="address" name="address" maxlength="500" rows="3"
                  class="form-control forma-input"
                  placeholder="Street, City, State, Postal Code"><%= (formData && formData.address) ? formData.address : '' %></textarea>
                <span class="form-text field-hint">Street address, city, state, and postal code.</span>
                <div class="invalid-feedback" id="error-address"></div>
              </div>
            </div>

            <div class="col-12">
              <div class="form-group terms-group" id="field-terms">
                <div class="form-check">
                  <input type="checkbox" id="terms" name="terms" value="on"
                    class="form-check-input"
                    <%= (formData && formData.terms) ? 'checked' : '' %>>
                  <label class="form-check-label fw-semibold" for="terms">
                    I accept the <a href="/about" class="text-primary text-decoration-none">Terms and Conditions</a>
                  </label>
                  <div class="invalid-feedback" id="error-terms"></div>
                </div>
              </div>
            </div>

          </div>

          <div class="completion-card mb-4">
            <span class="completion-label">Form completion</span>
            <span class="completion-value" id="completion-value">0</span>%
            <div class="completion-bar">
              <div class="completion-bar-fill" id="completion-bar-fill"></div>
            </div>
          </div>

          <div class="form-actions d-flex gap-3 justify-content-between align-items-center">
            <button type="submit" id="submitBtn" class="btn btn-primary btn-lg px-5 py-3 shadow-sm">
              Register Student
            </button>
            <button type="button" id="resetBtn" class="btn btn-outline-secondary px-5 py-3">Reset Form</button>
            <a href="/students" class="btn btn-outline-secondary px-5 py-3">View Student Records</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
<!-- ========== RECORDS PREVIEW SECTION ========== -->
<section class="records-preview section py-5 bg-light">
  <div class="container">
    <div class="row justify-content-center mb-5">
      <div class="col-lg-8 text-center">
        <h2 class="section-title fw-bold mb-3 animate-fade-in-up">Recent Student Records</h2>
        <p class="section-subtitle text-muted animate-fade-in-up animate-delay-100">
          Latest registrations in the Forma platform.
        </p>
      </div>
    </div>
    <% if (students && students.length > 0) { %>
      <div class="table-responsive animate-fade-in-up">
        <table class="table table-hover records-table align-middle mb-0">
          <thead class="table-navy">
            <tr>
              <th>#</th>
              <th>Full Name</th>
              <th>Student ID</th>
              <th>Email</th>
              <th>Course</th>
              <th class="text-end">Registered</th>
            </tr>
          </thead>
          <tbody>
            <% students.forEach(function (s, index) { %>
              <tr>
                <td><%= index + 1 %></td>
                <td><%= s.fullName %></td>
                <td><span class="badge bg-secondary"><%= s.studentId %></span></td>
                <td><%= s.email %></td>
                <td><%= s.course %></td>
                <td class="text-end text-muted small"><time><%= new Date(s.registeredAt).toLocaleDateString() %></time></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <div class="text-center mt-4 animate-fade-in-up animate-delay-200">
        <a href="/students" class="btn btn-primary">View All Records</a>
      </div>
    <% } else { %>
      <div class="text-center py-5 animate-fade-in-up">
        <div class="empty-icon fs-1 mb-3">&#128197;</div>
        <h3 class="fw-bold">No Student Records Yet</h3>
        <p class="text-muted">There are no registered students in the system. Be the first to register!</p>
        <a href="#registration" class="btn btn-primary">Register a Student</a>
      </div>
    <% } %>
  </div>
</section>
