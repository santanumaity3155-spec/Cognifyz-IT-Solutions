<!-- ========== STUDENT RECORDS PAGE ========== -->
<section class="students-section section py-5">
  <div class="container">
    <!-- Page header -->
    <div class="row mb-4 animate-fade-in-up">
      <div class="col-md-8">
        <h2 class="section-title fw-bold mb-2">Student Records</h2>
        <p class="text-muted mb-0">
          Total registered students: <strong class="text-navy"><%= total %></strong>
        </p>
      </div>
      <div class="col-md-4 d-flex justify-content-end align-items-center">
        <a href="/" class="btn btn-outline-primary">Back to Dashboard</a>
      </div>
    </div>

    <!-- Search + filter form -->
    <form action="/students" method="GET" class="search-filter-card card p-4 rounded-4 shadow-sm forma-card mb-4 animate-fade-in-up animate-delay-100">
      <div class="row g-3 align-items-end">
        <div class="col-md-4 col-lg-3">
          <label for="search" class="form-label fw-semibold visually-hidden">Search students</label>
          <input type="search" id="search" name="q" value="<%= query || '' %>"
            class="form-control forma-input"
            placeholder="Search by name, email, or student ID">
        </div>
        <div class="col-md-3 col-lg-2">
          <label for="filter-course" class="form-label fw-semibold visually-hidden">Filter by course</label>
          <select name="course" id="filter-course" class="form-select forma-select">
            <option value="">All courses</option>
            <% courses.forEach(function (c) { %>
              <option value="<%= c %>" <%= course === c ? 'selected' : '' %>><%= c %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-2 col-lg-2 d-grid">
          <button type="submit" class="btn btn-primary px-4">Filter</button>
        </div>
        <% if (query || course) { %>
          <div class="col-md-2 col-lg-2 d-grid">
            <a href="/students" class="btn btn-outline-secondary px-4">Clear</a>
          </div>
        <% } %>
        <div class="col-md-1 col-lg-3 d-flex justify-content-end">
          <span class="text-muted small">
            <%= hasStudents ? students.length : 0 %> of <%= total %> record<%= total !== 1 ? 's' : '' %>
          </span>
        </div>
      </div>
    </form>

    <% if (hasStudents) { %>
      <!-- Records table -->
      <div class="table-responsive animate-fade-in-up animate-delay-200">
        <table class="table table-hover records-table align-middle mb-0">
          <thead class="table-navy">
            <tr>
              <th>#</th>
              <th>Full Name</th>
              <th>Student ID</th>
              <th>Email Address</th>
              <th>Course</th>
              <th>Gender</th>
              <th>Date of Birth</th>
              <th class="text-end">Registered</th>
            </tr>
          </thead>
          <tbody>
            <% students.forEach(function (s, index) { %>
              <tr>
                <td><%= index + 1 %></td>
                <td><strong><%= s.fullName %></strong></td>
                <td><span class="badge bg-secondary"><%= s.studentId %></span></td>
                <td><%= s.email %></td>
                <td><%= s.course %></td>
                <td><span class="badge forma-badge-<%= s.gender.toLowerCase().replace(' ', '-') %>"><%= s.gender %></span></td>
                <td><%= s.dateOfBirth %></td>
                <td class="text-end text-muted small"><time><%= new Date(s.registeredAt).toLocaleString() %></time></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <div class="text-center mt-4 animate-fade-in-up animate-delay-300">
        <p class="count-note text-muted">
          Showing <%= students.length %> of <%= total %> registered student<%= total !== 1 ? 's' : '' %>.
        </p>
      </div>
    <% } else { %>
      <!-- Empty state -->
      <div class="text-center py-5 animate-fade-in-up">
        <div class="empty-icon fs-1 mb-3">&#128197;</div>
        <% if (query || course) { %>
          <h3 class="fw-bold text-navy">No matching students</h3>
          <p class="text-muted">No students match your current search or course filter.</p>
        <% } else { %>
          <h3 class="fw-bold text-navy">No Student Records Yet</h3>
          <p class="text-muted">There are no registered students in the system. Be the first to register!</p>
        <% } %>
        <div class="d-grid d-md-flex justify-content-center gap-3">
          <a href="/" class="btn btn-primary">Register a Student</a>
          <a href="/students" class="btn btn-outline-secondary">Clear Filters</a>
        </div>
      </div>
    <% } %>
  </div>
</section>