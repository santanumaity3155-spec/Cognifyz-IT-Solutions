# ==============================================================================
# Forma – Student Intelligence Platform (Level 3, Task 6)
# Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values appropriate for your environment.
# Never commit real secrets, private keys, or credentials to version control.
# ==============================================================================

# Server Port
PORT=5000

# MongoDB Persistent Database Connection URI
# e.g., mongodb://127.0.0.1:27017/forma_task6 or mongodb+srv://<user>:<password>@cluster.mongodb.net/forma_task6
# Note: If MongoDB service is offline, the backend engages a documented in-memory fallback.
MONGODB_URI=mongodb://127.0.0.1:27017/forma_task6

# JSON Web Token (JWT) Secret
# In production, this must be a high-entropy random string of at least 32 characters.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters_long_for_production

# JWT Expiration Duration (e.g. 1d, 12h, 7d)
JWT_EXPIRES_IN=1d

# Allowed Frontend Client Origin for CORS and CSRF verification
CLIENT_URL=http://localhost:5173

# Application Environment Mode ('development' | 'production' | 'test')
NODE_ENV=development

# Cookie-Parser Secret for Signed Cookie Verification
# In production, this must be a random secret of at least 32 characters.
COOKIE_SECRET=replace_with_cookie_parser_secret_at_least_32_characters_long
