# Forma Developer Intelligence Platform - Backend Configuration
# Cognifyz Level 4: Expert - Task 7: Advanced API Usage and External API Integration

# Server Network Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5174

# Database Configuration (Mongoose with automatic in-memory fallback store)
# If MongoDB is unavailable or blank, system runs in non-persistent in-memory mode
MONGODB_URI=mongodb://127.0.0.1:27017/forma_task7

# Authentication & Session Security (Secrets must be at least 32 characters in production)
JWT_SECRET=forma_task7_jwt_secret_dev_environment_32chars_min!
JWT_EXPIRES_IN=1d
COOKIE_SECRET=forma_task7_cookie_secret_dev_32chars_min!

# Token Encryption at Rest (AES-256-GCM - exactly 32-byte / 64-hex-char key in production)
GITHUB_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# External API Integration - GitHub OAuth 2.0 Credentials
# Register your OAuth App at: https://github.com/settings/developers
# Homepage URL: http://localhost:5174
# Authorization callback URL: http://localhost:5001/api/github/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:5001/api/github/callback

